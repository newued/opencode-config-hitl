{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/hy3-free",
  "small_model": "opencode/hy3-free",
  "plugin": [
    "oh-my-opencode-slim",
    "opencode-agent-memory"
  ],
  "theme": "opencode",
  "autoupdate": true,
  "shell": "bash",
  "permission": {
    "bash": {
      "*": "allow",
      "rmdir*": "deny",
      "rd*": "deny",
      "del*": "deny",
      "rm*": "deny"
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-7a4833bf-851a-4d23-b5dd-0532fc2ada3c"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
